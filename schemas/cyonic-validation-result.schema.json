{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XRastlinX/logos-formal/schemas/cyonic-validation-result.schema.json",
  "title": "Cyonic Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "validatorVersion",
    "cubedBit",
    "validatorOperator",
    "authorityEffect",
    "validationProfile",
    "metadataScope",
    "target",
    "checks",
    "routerDecision"
  ],
  "properties": {
    "schema": {
      "const": "urn:cyonic:validation-result:v1"
    },
    "version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "VALIDATED",
        "REJECTED"
      ]
    },
    "validatorVersion": {
      "const": "0.1.0"
    },
    "cubedBit": {
      "const": "010"
    },
    "validatorOperator": {
      "const": "000"
    },
    "authorityEffect": {
      "const": "NONE"
    },
    "validationProfile": {
      "type": "string"
    },
    "metadataScope": {
      "enum": [
        "EXACT",
        "UNDECLARED"
      ]
    },
    "target": {
      "type": "string"
    },
    "targetRoot": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "total",
        "results"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASSED",
                  "FAILED"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "routerDecision": {
      "enum": [
        "OBSERVE_ONLY",
        "REJECT"
      ]
    },
    "rejectedInvariant": {
      "type": "string"
    },
    "decisionRoot": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VALIDATED"
          }
        }
      },
      "then": {
        "properties": {
          "routerDecision": {
            "const": "OBSERVE_ONLY"
          }
        },
        "required": [
          "targetRoot",
          "decisionRoot"
        ]
      }
    }
  ]
}
