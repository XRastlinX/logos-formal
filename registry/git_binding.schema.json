{
  "$id": "https://github.com/XRastlinX/logos-formal/registry/git_binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactRoot": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "sha256"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "alg",
        "value"
      ],
      "type": "object"
    },
    "commitOid": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]+$",
          "type": "string"
        }
      ]
    },
    "objectFormat": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "parentOids": {
      "items": {
        "pattern": "^[0-9a-f]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "refAtObservation": {
      "minLength": 1,
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "treeOid": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]+$",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "repository",
    "objectFormat",
    "commitOid",
    "treeOid",
    "parentOids",
    "refAtObservation",
    "artifactRoot"
  ],
  "title": "Placetime 13D Git Binding",
  "type": "object"
}
