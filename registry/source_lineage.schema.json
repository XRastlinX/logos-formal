{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XRastlinX/logos-formal/registry/source_lineage.schema.json",
  "title": "Placetime 13D Source Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "authorityEffect", "sources", "adjudication"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "urn:logos-formal:placetime-13d-source-lineage:v0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "PROPOSED"},
    "authorityEffect": {"const": "NONE"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "archivePath": {"type": "string", "minLength": 1},
          "sourceName": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinatePartition", "hardeningRule", "excludedFromCoordinates"],
      "properties": {
        "coordinatePartition": {"type": "string", "minLength": 1},
        "hardeningRule": {"type": "string", "minLength": 1},
        "excludedFromCoordinates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
