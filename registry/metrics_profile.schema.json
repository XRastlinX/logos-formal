{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XRastlinX/logos-formal/registry/metrics_profile.schema.json",
  "title": "Placetime 13D Metric Definition Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "authorityEffect", "metrics", "admissionRule"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "urn:logos-formal:placetime-13d-metrics-profile:v0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "PROPOSED"},
    "authorityEffect": {"const": "NONE"},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numerator",
          "denominator",
          "unit",
          "scope",
          "observationWindow",
          "uncertainty",
          "source",
          "coordinateIds",
          "calculation"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "numerator": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "observationWindow": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "coordinateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^d(0[1-9]|1[0-3])$"}
          },
          "calculation": {"const": "NON_NULL_COUNT_OVER_DECLARED_COUNT"}
        }
      }
    },
    "admissionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "note"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "numerator",
              "denominator",
              "unit",
              "scope",
              "observationWindow",
              "uncertainty",
              "source",
              "coordinateIds",
              "calculation"
            ]
          }
        },
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
