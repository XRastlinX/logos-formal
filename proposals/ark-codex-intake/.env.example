# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Boundary secrets are mandatory. Use independent random values.
AUTH_SECRET="replace-with-operator-auth-secret"
SIGNING_SECRET="replace-with-lease-hmac-secret"
RECEIPT_SECRET="replace-with-audit-receipt-hmac-secret"
REGISTRY_SECRET="replace-with-registry-update-hmac-secret"
ACTIVE_KEY_ID="local-key-v1"
REGISTRY_KEY_ID="registry-authority-key-v1"

# FOUNDRY enables protected mutation routes. BEACON is read-only.
ARK_PLACE="BEACON"
ARK_DB_PATH="./data/ark-boundary.sqlite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
