{
  "name": "ark-codex-intake",
  "private": true,
  "version": "0.3.0",
  "description": "Proposed local reference implementation for graph-bound obligation routing and adversarial recovery assays.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contention": "node --import tsx --test test/contention_stress.test.ts",
    "test:torsion": "node --import tsx --test test/dynamic_torsion.test.ts test/migration_v3.test.ts",
    "research:jitter": "tsx research/gue-jitter-simulator.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  }
}
